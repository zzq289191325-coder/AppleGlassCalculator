<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="TextPrimaryColor">#FFF7F8FC</Color>
    <Color x:Key="TextSecondaryColor">#C8DCE2EC</Color>
    <Color x:Key="TextMutedColor">#92D1D8E4</Color>
    <Color x:Key="CoralColor">#FFFF7D75</Color>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="CoralBrush" Color="{StaticResource CoralColor}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#82FFFFFF" />
    <SolidColorBrush x:Key="SoftHairlineBrush" Color="#38FFFFFF" />

    <LinearGradientBrush x:Key="WindowSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EC7F8DA3" Offset="0" />
        <GradientStop Color="#E5717583" Offset="0.55" />
        <GradientStop Color="#E88A716C" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#58FFFFFF" Offset="0" />
        <GradientStop Color="#24E8F1FF" Offset="0.3" />
        <GradientStop Color="#12FFFFFF" Offset="0.6" />
        <GradientStop Color="#3AFFD9C5" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassPanelBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8FFFFFF" Offset="0" />
        <GradientStop Color="#80D8E8FF" Offset="0.34" />
        <GradientStop Color="#62FFFFFF" Offset="0.66" />
        <GradientStop Color="#C8FFE4D0" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="NumberButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#62F7FAFF" Offset="0" />
        <GradientStop Color="#2CE4ECF9" Offset="0.38" />
        <GradientStop Color="#18FFFFFF" Offset="0.66" />
        <GradientStop Color="#3AFFDCCB" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OperatorButtonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E8FFD69F" Offset="0" />
        <GradientStop Color="#E0F9A54D" Offset="0.45" />
        <GradientStop Color="#EAEA7B28" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
