<Window x:Class="AppleGlassCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="计算器"
        Width="452" Height="748"
        MinWidth="410" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown"
        StateChanged="Window_StateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="8"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="WindowShell"
            Margin="0"
            CornerRadius="38"
            Background="{StaticResource WindowSurfaceBrush}"
            BorderBrush="#C8FFFFFF"
            BorderThickness="1.2"
            SnapsToDevicePixels="False">
        <Grid>
            <Border Margin="1" CornerRadius="37" BorderThickness="1.4" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F2FFFFFF" Offset="0" />
                        <GradientStop Color="#94D7E8FF" Offset="0.28" />
                        <GradientStop Color="#40FFFFFF" Offset="0.58" />
                        <GradientStop Color="#D0FFE4CF" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
            <Border Margin="3" CornerRadius="35" BorderThickness="1,1,0.8,0.8" IsHitTestVisible="False">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#54FFFFFF" Offset="0" />
                        <GradientStop Color="#12FFFFFF" Offset="0.5" />
                        <GradientStop Color="#72FFD6BE" Offset="1" />
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>

            <Ellipse Width="430" Height="500" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-235,-185,0,0" IsHitTestVisible="False" CacheMode="BitmapCache">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#5CA9CBFF" Offset="0" />
                        <GradientStop Color="#2AA9CBFF" Offset="0.5" />
                        <GradientStop Color="#009FC3FF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="440" Height="600" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-185,-165" IsHitTestVisible="False" CacheMode="BitmapCache">
                <Ellipse.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                        <GradientStop Color="#80FFA464" Offset="0" />
                        <GradientStop Color="#40FFA464" Offset="0.52" />
                        <GradientStop Color="#00FF9A5C" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Border Width="150" HorizontalAlignment="Right" Margin="0,0,-28,0" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#00FFBF8A" Offset="0" />
                        <GradientStop Color="#10FFBF8A" Offset="0.45" />
                        <GradientStop Color="#3CFFA568" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Margin="2" CornerRadius="32" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#46FFFFFF" Offset="0" />
                        <GradientStop Color="#14DAEAFF" Offset="0.28" />
                        <GradientStop Color="#00FFFFFF" Offset="0.58" />
                        <GradientStop Color="#36FFD2B6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid MaxWidth="540" Margin="26,22,26,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="74" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="126" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="96" />
                    <RowDefinition Height="17" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="#01FFFFFF" MouseLeftButtonDown="TitleArea_MouseLeftButtonDown">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="计算器" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                   FontSize="29" FontWeight="SemiBold" />
                        <TextBlock Text="标准计算" Foreground="{StaticResource TextSecondaryBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
                                   FontSize="15" Margin="1,2,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,0,0">
                        <Button Style="{StaticResource TrafficButtonStyle}" Background="#FFFF5F57" Click="CloseButton_Click"
                                ToolTip="关闭" automation:AutomationProperties.Name="关闭窗口" />
                        <Button Style="{StaticResource TrafficButtonStyle}" Background="#FFFF9F0A" Click="MinimizeButton_Click"
                                ToolTip="最小化" automation:AutomationProperties.Name="最小化窗口" />
                        <Button Style="{StaticResource TrafficButtonStyle}" Background="#FF28C840"
                                PreviewMouseLeftButtonDown="DragButton_MouseLeftButtonDown"
                                ToolTip="按住拖动窗口" automation:AutomationProperties.Name="拖动窗口" />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="2" CornerRadius="24" Background="{StaticResource GlassPanelBrush}"
                        BorderBrush="{StaticResource GlassPanelBorderBrush}" BorderThickness="1.05" Padding="20,15,20,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="ExpressionDisplay" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="17"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
                        <Viewbox Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="58">
                            <TextBlock x:Name="ResultDisplay" Text="0" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontFamily="Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI"
                                       FontSize="47" FontWeight="Medium" TextWrapping="NoWrap" />
                        </Viewbox>
                    </Grid>
                </Border>

                <Border Grid.Row="4" CornerRadius="22" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassPanelBorderBrush}" BorderThickness="1" Padding="15,10,12,9">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="历史" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13.5"
                                   FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" VerticalAlignment="Center" />
                        <Button Grid.Row="0" Content="清空" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource QuietButtonStyle}" Click="ClearHistoryButton_Click"
                                automation:AutomationProperties.Name="清空历史记录" />
                        <TextBlock x:Name="HistoryEmptyText" Grid.Row="1" Text="完成计算后，记录会出现在这里"
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="12.5" VerticalAlignment="Center" />
                        <ScrollViewer x:Name="HistoryScrollViewer" Grid.Row="1"
                                      HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled"
                                      PanningMode="HorizontalOnly" PreviewMouseWheel="HistoryScrollViewer_PreviewMouseWheel">
                            <ScrollViewer.Resources>
                                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource HistoryHorizontalScrollBarStyle}" />
                            </ScrollViewer.Resources>
                            <ItemsControl ItemsSource="{Binding HistoryItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="142" BorderBrush="#28FFFFFF" BorderThickness="0,0,1,0" Margin="0,0,12,0" Padding="0,1,12,0">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Expression}" Foreground="{StaticResource TextSecondaryBrush}"
                                                           FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <TextBlock Text="{Binding Result}" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontSize="13" FontWeight="SemiBold" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid Grid.Row="6" Margin="-5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Margin="5" Content="C" Tag="C" Foreground="{StaticResource CoralBrush}" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="0" Grid.Column="1" Margin="5" Content="CE" Tag="CE" FontSize="21" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="5" Content="⌫" Tag="Back" FontSize="24" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" automation:AutomationProperties.Name="退格" />
                    <Button Grid.Row="0" Grid.Column="3" Margin="5" Content="÷" Tag="/" Style="{StaticResource OperatorButtonStyle}" Click="CalculatorButton_Click" />

                    <Button Grid.Row="1" Grid.Column="0" Margin="5" Content="7" Tag="7" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="1" Grid.Column="1" Margin="5" Content="8" Tag="8" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="5" Content="9" Tag="9" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="1" Grid.Column="3" Margin="5" Content="×" Tag="*" Style="{StaticResource OperatorButtonStyle}" Click="CalculatorButton_Click" />

                    <Button Grid.Row="2" Grid.Column="0" Margin="5" Content="4" Tag="4" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="2" Grid.Column="1" Margin="5" Content="5" Tag="5" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="2" Grid.Column="2" Margin="5" Content="6" Tag="6" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="2" Grid.Column="3" Margin="5" Content="−" Tag="-" Style="{StaticResource OperatorButtonStyle}" Click="CalculatorButton_Click" />

                    <Button Grid.Row="3" Grid.Column="0" Margin="5" Content="1" Tag="1" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="3" Grid.Column="1" Margin="5" Content="2" Tag="2" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="3" Grid.Column="2" Margin="5" Content="3" Tag="3" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="3" Grid.Column="3" Margin="5" Content="+" Tag="+" Style="{StaticResource OperatorButtonStyle}" Click="CalculatorButton_Click" />

                    <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Content="0" Tag="0" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" />
                    <Button Grid.Row="4" Grid.Column="2" Margin="5" Content="·" Tag="." FontSize="29" Style="{StaticResource GlassButtonStyle}" Click="CalculatorButton_Click" automation:AutomationProperties.Name="小数点" />
                    <Button Grid.Row="4" Grid.Column="3" Margin="5" Content="=" Tag="=" FontSize="32" Style="{StaticResource OperatorButtonStyle}" Click="CalculatorButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
